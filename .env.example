# Copy to .env.local. These three values are public identifiers (they ship to the browser).
# Never put the Appwrite API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6ac89ae4003507a218a0
NEXT_PUBLIC_APPWRITE_BUCKET_ID=pdfs

# ---- AI features (summaries and questions about a PDF) ----
# Everything below is SERVER ONLY. Never prefix these with NEXT_PUBLIC_, or the key ships to the browser.

# Required. Create one at https://platform.deepseek.com. Without it the AI endpoints answer "not_configured".
DEEPSEEK_API_KEY=
# Optional. Default: deepseek-flash (see https://api-docs.deepseek.com for current names).
# DEEPSEEK_MODEL=deepseek-flash
# Optional. Default: https://api.deepseek.com
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional. Voyage AI embeddings, used only to pick relevant pages when a PDF is too long to send whole.
# Leave empty to use the built-in keyword matching instead (works for English and Chinese).
VOYAGE_API_KEY=
# Optional. Default: voyage-4-lite (cheapest current model)
# VOYAGE_MODEL=voyage-4-lite
